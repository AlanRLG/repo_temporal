# Nexys 3 (Spartan-6 XC6SLX16 CSG324)
# Reloj de 100 MHz
NET "clk" LOC = V10 | IOSTANDARD = LVCMOS33;
NET "clk" TNM_NET = clk_pin;
TIMESPEC TS_clk_pin = PERIOD clk_pin 100 MHz HIGH 50%;
# Switches
NET "x<0>"  LOC = T10 | IOSTANDARD = LVCMOS33;  # SW0
NET "x<1>"  LOC = T9  | IOSTANDARD = LVCMOS33;  # SW1
NET "reset" LOC = T5  | IOSTANDARD = LVCMOS33;  # SW7
# LEDs
NET "salida<0>" LOC = U16 | IOSTANDARD = LVCMOS33;  # LD0
NET "salida<1>" LOC = V16 | IOSTANDARD = LVCMOS33;  # LD1
NET "salida<2>" LOC = U15 | IOSTANDARD = LVCMOS33;  # LD2
NET "salida<3>" LOC = V15 | IOSTANDARD = LVCMOS33;  # LD3
